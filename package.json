{
  "name": "kiwipot-habits",
  "version": "1.0.1",
  "private": true,
  "description": "A habit tracker for Kiwipot: habits to tick off each day, with your streaks, in a note.",
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --format=iife --target=es2020 --minify --legal-comments=none --outfile=dist/plugin.js",
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.18.8",
    "esbuild": "0.25.10",
    "typescript": "5.9.3"
  },
  "license": "MIT"
}
